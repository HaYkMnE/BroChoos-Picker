<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- TFM carries an explicit platform version: the SDK otherwise re-derives TPV=7.0 from a bare "-windows" TFM, which conflicts with SupportedOSPlatformVersion (NETSDK1135). App and tests must share the same TPV for project-reference compatibility. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>BroChoos.Platform.Windows</RootNamespace>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BroChoos.Core\BroChoos.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
