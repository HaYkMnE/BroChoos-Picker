<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- W5.4: Armenian localization resources. Must maintain key parity with Strings.en.axaml -->
  
  <!-- Picker Window -->
  <sys:String x:Key="picker.select.hints">1-9 ընտրել  ·  Tab/սլաքներ՝ տեղաշարժ  ·  Enter բացել  ·  Ctrl+C պատճենել  ·  Esc չեղարկել</sys:String>
  
  <!-- Ghost Toast (3s, non-interactive) -->
  <sys:String x:Key="GhostToast.Opened">Բացվեց</sys:String>
  
  <!-- Cleanup Recovery Toast (8s, interactive) -->
  <sys:String x:Key="CleanupToast.Title">Մաքրման վերականգնում</sys:String>
  <sys:String x:Key="CleanupToast.RestoreButton">Վերականգնել</sys:String>
  
  <!-- Picker ViewModel Status Messages -->
  <sys:String x:Key="Status.LaunchFailure">Չհաջողվեց բացել {0} ({1})։ Փորձեք այլ քարտ, F՝ համակարգի համար, Ctrl+C՝ պատճենելու, Esc՝ չեղարկելու համար։</sys:String>
  <sys:String x:Key="Status.Copied">URL-ը պատճենվեց սեղմատախտակին։</sys:String>
  <sys:String x:Key="Status.CopyFailed">Պատճենումը չհաջողվեց։ URL-ը դեռ տեսանելի է վերևի հղման քարտում։</sys:String>

  <!-- W7.2 պատճառների բառապաշար. յուրաքանչյուր ոչ լռելյայն դասավորություն ունի տեսանելի պատճառ, «Recommended» բառն արգելված է։ -->
  <sys:String x:Key="Suggestion.Reason.MatchedRule">Առաջարկված կանոնով՝ {0}</sys:String>
  <sys:String x:Key="Suggestion.Reason.MatchedRuleGeneric">Առաջարկված համընկած կանոնով</sys:String>
  <sys:String x:Key="Suggestion.Reason.RecentSession">Վերջին ընտրությունը այս նստաշրջանում</sys:String>
  <sys:String x:Key="Suggestion.Reason.ProbableSource">Հավանաբար բացված է սկզբնաղբյուր հավելվածից</sys:String>
  <sys:String x:Key="Suggestion.Reason.AllChoices">Բոլոր ընտրանքները</sys:String>
  
  <!-- First Run Prompt -->
  <sys:String x:Key="FirstRun.Prompt">BroChoos-ը դեռ չի որոնել բրաուզերներ այս համակարգչում։ «Գտնել բրաուզերներ»-ը որոնումը կսկսի հիմա, կամ կարող եք բաց թողնել և որոշել ավելի ուշ։</sys:String>
  <sys:String x:Key="FirstRun.FindBrowsers">Գտնել բրաուզերներ</sys:String>
  <sys:String x:Key="FirstRun.AddManually">Ավելացնել ձեռքով</sys:String>
  <sys:String x:Key="FirstRun.Skip">Բաց թողնել</sys:String>
</ResourceDictionary>
