<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BroChoos.App.Picker.GhostToastWindow"
        Width="300"
        Height="56"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        Background="Transparent"
        SystemDecorations="None">
  <Border Padding="12"
          AutomationProperties.LiveSetting="Polite"
          CornerRadius="8"
          Background="{DynamicResource bc.bg.card}"
          BorderBrush="{DynamicResource bc.border.strong}"
          BorderThickness="1">
    <TextBlock Text="{DynamicResource GhostToast.Opened}"
               FontSize="{DynamicResource bc.type.caption}"
               Foreground="{DynamicResource bc.text.primary}"/>
  </Border>
</Window>
